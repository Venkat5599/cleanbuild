# ── RATCHET environment ──────────────────────────────────────────────────────
# Copy to .env for local runs. Deployment secrets are set per platform
# (wrangler secret put / Vercel env), never committed.
#
# Everything in this file is read by code. Nothing else is.

# ── Autonomous follow-up (local scripts and the Worker) ──────────────────────
# Minds Builder API key — a JWT issued at build.hellominds.ai.
# Sent as the X-Api-Key header to https://api.build.hellominds.ai
MINDS_BUILDER_API_KEY=
# Conversation alias the worker messages when an experiment matures.
MINDS_ALIAS=

# Telegram fallback channel for autonomous follow-up.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Worker secrets (set with `wrangler secret put`, not here) ────────────────
# Upstash Redis over HTTP. Backs the cron lock and Prometheus counters.
# Workers cannot hold TCP Redis connections, so the REST API is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OpenTelemetry OTLP/HTTP. Any OTel-compatible collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Bearer token required to scrape /metrics.
METRICS_TOKEN=

# ── Fact extraction (memory graph scripts only, optional) ────────────────────
# OpenAI-compatible endpoint used for the mechanical parts of memory
# (claim extraction, phrasing belief changes), so the Mind's cognition is
# spent on judgement rather than parsing.
AICREDITS_API_KEY=
AICREDITS_BASE_URL=https://aicredits.in/api/v1
EXTRACTION_MODEL=deepseek/deepseek-v4-flash

# ── Canon-gate embeddings (optional) ────────────────────────────────────────
# OpenAI-compatible /embeddings endpoint. Unset, the gate runs its
# deterministic token-overlap rule only; set, it additionally blocks drafts
# whose cosine similarity to a canon claim clears 0.8. Claims are embedded
# once and cached in the claims table.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ── YouTube connector (optional) ────────────────────────────────────────────
# Public Google API key with the YouTube Data API v3 enabled. Unset, the
# connector module exists but ingest/poll never run.
YOUTUBE_API_KEY=

# ── Dashboard (saas/) ────────────────────────────────────────────────────────
# oRPC endpoint of the deployed Worker. Unset, the dashboard renders the
# labelled snapshot in saas/lib/snapshot.json and says so on every page.
RATCHET_API_URL=