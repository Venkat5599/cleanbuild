# Postgres (Neon). Required.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
NEON_PROJECT_ID=

# Minds Builder API. Key is a JWT issued at build.hellominds.ai.
# Sent as the X-Api-Key header to https://api.build.hellominds.ai
MINDS_BUILDER_API_KEY=
# Conversation alias the worker messages when an experiment matures.
MINDS_ALIAS=

# Telegram fallback channel for autonomous follow-up.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube Data API v3 (read-only scope).
YOUTUBE_API_KEY=

# Upstash Redis over HTTP. Backs the cron lock and Prometheus counters.
# Workers cannot hold TCP Redis connections, so the REST API is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OpenTelemetry OTLP/HTTP. Any OTel-compatible collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Bearer token required to scrape /metrics.
METRICS_TOKEN=
